# Токен вашего Telegram бота (получить у @BotFather)
TG_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Список ID администраторов через запятую (кому будут приходить уведомления)
ADMIN_IDS=123456789,987654321

# URL реле на Render для обхода блокировок Telegram и ИИ-анализа (Опционально)
RELAY_URL=https://your-app-name.onrender.com

# ИИ-анализ лотов на сервере реле (Опционально)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Прокси для Telegram (Опционально. Если задан RELAY_URL, прокси игнорируется)
# TG_PROXY=socks5://127.0.0.1:10808
# TG_PROXY=http://логин:пароль@ip:порт
TG_PROXY=

# Ссылки на поиск Авито через запятую. Обязательно с сортировкой s=104
TARGET_URL=https://www.avito.ru/all/telefony/mobilnye_telefony/apple-ASgBAgICAkS0wA3OqzmwwQ2I_Dc?s=104&q=iphone+13+pro, https://www.avito.ru/all/telefony/mobilnye_telefony/apple-ASgBAgICAkS0wA3OqzmwwQ2I_Dc?s=104&q=iphone+14+pro

# Минимальная цена (отсекаем мусор, чехлы и лоты за 1 руб)
MIN_PRICE=500

# Интервалы задержки (в секундах)
MIN_DELAY=150
MAX_DELAY=240
