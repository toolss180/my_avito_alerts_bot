# Токен вашего Telegram бота (получить у @BotFather)
TG_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Список ID администраторов через запятую (кому будут приходить уведомления)
ADMIN_IDS=123456789,987654321

# Прокси для Telegram (Опционально, Авито будет работать напрямую без него)
# TG_PROXY=socks5://127.0.0.1:10808
# TG_PROXY=http://логин:пароль@ip:порт
TG_PROXY=

# Ссылка на поиск Авито. Обязательно с сортировкой s=104
TARGET_URL=https://www.avito.ru/all/telefony/mobilnye_telefony/apple-ASgBAgICAkS0wA3OqzmwwQ2I_Dc?s=104&q=iphone+13+pro

# Минимальная и максимальная цена
MIN_PRICE=15000
MAX_BUY_PRICE=28000
ESTIMATED_MARKET=35000

# Интервалы задержки (в секундах)
MIN_DELAY=150
MAX_DELAY=240
